# LiteChainIndexer — Environment Variables
# Copy this to .env or set in your environment

# Data directory for state + parquet (NDJSON is optional, see NDJSON_ENABLED)
# DATA_DIR=/var/data/chain-indexer

# ClickHouse connection
# CH_HOST=127.0.0.1            (alias: CLICKHOUSE_HOST)
# CH_PORT=9000                 (alias: CLICKHOUSE_PORT)
# CH_USER=default              (alias: CLICKHOUSE_USER)
# CH_PASSWORD=
# CH_DATABASE=wallet_memory

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# RPC timeout (seconds)
# RPC_TIMEOUT=30

# Disk cap (bytes) — default 10GB
# DISK_CAP_GB=10

# ═══════════════════════════════════════════════════════════════════════
# v1.3.0 Feature Flags
# ═══════════════════════════════════════════════════════════════════════

# NDJSON write-ahead log (default OFF — redundant with ClickHouse; recovery
# is restart-from-state with at most one ~30s sync cycle lost)
# NDJSON_ENABLED=0

# Lazy per-chain DEX/deployer indexing (default ON): long-tail chains index
# DEX/deployer events only after the scanner signals demand via a file touch
# in INDEXER_DEMAND_DIR. Set to 0 for the legacy all-events behavior.
# LAZY_INDEXING_ENABLED=1
# INDEXER_DEMAND_DIR=/tmp/indexer-demand

# Enrichment stripping — always on, non-configurable. Transfer rows carry
# only hot-path columns; token metadata lives in wallet_memory.token_meta_ref.

# Address-first wallet access projections on evm_transfers
# WALLET_PROJECTION_ENABLED=1

# Per-token incremental holder balance cache
# BALANCE_CACHE_ENABLED=1

# SummingMergeTree materialized holder balances (auto-maintained by CH)
# HOLDER_BALANCES_MV_ENABLED=1

# Reorg staging + fork rollback (EVM; Solana/Tron never invoke the EVM module)
# REORG_PROTECTION_ENABLED=1

# Default ON — the collector is bounded per-cycle and rate-limit-aware. Set to 0
# to disable. Per-cycle block cap + concurrency also tunable.
# TRACE_ENABLED=1
# TRACE_MAX_BLOCKS_PER_CYCLE=100
# TRACE_CONCURRENCY=2

# Balance reconciliation (TrueBlocks-style): computed vs on-chain balances
# RECONCILIATION_ENABLED=1
# RECONCILIATION_SAMPLE_SIZE=100

# Bloom pre-filtering (geth-conformant byte order)
# BLOOM_ENABLED=1
# Optional Redis backing for the bloom cache
# REDIS_URL=

# Column-level ClickHouse TTL / retention
# CH_TTL_ENABLED=1

# Parquet cold tier
# PARQUET_COLD_DAYS=7
# PARQUET_REMOTE=b2-crypt:chain-data/parquet

# On-demand historical RPC queries (lite_indexer.query — "no full indexing")
# Enable the QueryRouter's RPC leg: queries not covered by ClickHouse or
# the B2 parquet cold tier fall through to the chain's RPC pool on demand.
# ON_DEMAND_RPC_ENABLED=1
# How long (seconds) fetched RPC results are cached before refetching:
# ON_DEMAND_RPC_CACHE_TTL=3600
# Max block range for one on-demand RPC query (wider windows are clamped):
# ON_DEMAND_RPC_MAX_BLOCK_RANGE=5000
# Max consecutive on-demand RPC calls before pausing (free-tier protection):
# ON_DEMAND_RPC_MAX_CONSECUTIVE=10
# Pause duration (seconds) after the consecutive-call budget is exhausted:
# ON_DEMAND_RPC_PAUSE_SECONDS=1.0
# Max entries in the on-demand RPC result cache (bounds memory):
# ON_DEMAND_RPC_CACHE_MAX_ENTRIES=2048
# API bridge timeout (seconds) for one on-demand fallback call:
# ON_DEMAND_API_TIMEOUT=30.0

# Snapshot bootstrap (public B2 parquet snapshots → ClickHouse in minutes)
# rclone remote root where bootstrap snapshots live:
# BOOTSTRAP_B2_BUCKET=b2-crypt:chain-data
# Path prefix inside the bucket (snapshots live at {bucket}/{path}/{date}/{chain}/):
# BOOTSTRAP_PARQUET_PATH=snapshots
# Local staging dir for snapshot downloads (default: {DATA_DIR}/bootstrap):
# BOOTSTRAP_LOCAL_DIR=/var/data/chain-indexer/bootstrap
# file() path root when ClickHouse runs in a container and the download
# dir is mounted elsewhere inside it (empty = use BOOTSTRAP_LOCAL_DIR):
# BOOTSTRAP_CH_FILE_ROOT=
# Max seconds for one rclone snapshot download/upload:
# BOOTSTRAP_RCLONE_TIMEOUT=1200

# ═══════════════════════════════════════════════════════════════════════
# Paid RPC Support
# ═══════════════════════════════════════════════════════════════════════
# 
# When ALLOW_PAID_RPC=true, the indexer falls back to FREEMIUM and PAID
# tier RPC endpoints (Infura, Alchemy, Helius, etc.) when free endpoints
# are exhausted or rate-limited. Set to "true" to enable.
# 
# ALLOW_PAID_RPC=false
# 
# API keys for paid/freemium RPC endpoints. These are resolved from
# ${ENV_VAR} templates defined in lite_indexer/chains/endpoints.py and
# lite_indexer/chains/non_evm.py. Leave unset to use only free public RPCs.
# Unexpanded ${ENV_VAR} placeholders are filtered from the pool at import.
# 
# INFURA_KEY=
# ALCHEMY_KEY=
# GETBLOCK_KEY=
# CHAINSTACK_KEY=
# QUICKNODE_ENDPOINT=
# HELIUS_KEY=
# TRONGRID_KEY=

# ═══════════════════════════════════════════════════════════════════════
# Whale Detection + USD Price Normalization
# ═══════════════════════════════════════════════════════════════════════

# A DEX swap is a whale when the USD notional of either leg is >= this
# threshold (needs a price from token_prices), OR the raw amount exceeds
# the per-chain heuristic threshold. Written to dex_events.whale (UInt8).
# WHALE_THRESHOLD_USD=100000

# Per-chain raw-amount heuristic thresholds (base units) as JSON, e.g.
# WHALE_AMOUNT_THRESHOLDS_JSON='{"ethereum": 1000000000000000000000000}'
# (defaults: 1e23 EVM / 1e14 Solana / 1e11 Tron ~= $100K at $1 per token)

# USD price feed (DefiLlama primary + CoinGecko fallback, free tiers, no
# API keys). Master switch + refresh interval (seconds, default 900 = 15m).
# PRICING_ENABLED=1
# PRICING_REFRESH_INTERVAL=900

# Free-tier request pacing (seconds between calls per provider)
# COINGECKO_MIN_INTERVAL=12
# DEFILLAMA_MIN_INTERVAL=2

# Token budget per refresh + recent-window scan
# PRICING_MAX_TRACKED_TOKENS=2500
# PRICING_TOKEN_WINDOW_DAYS=7

# Backfill: lite-indexer backfill-whales --chain ethereum --days 90 --dry-run

# ═══════════════════════════════════════════════════════════════════════
# LanceDB Vector Store (AI-vector-ready indexing)
# ═══════════════════════════════════════════════════════════════════════

# Embedded vector database directory. No server process — LanceDB is
# columnar, disk-based, and zero-cost. Pairs with ClickHouse: CH answers
# analytical SQL, LanceDB answers semantic/ANN queries (wallet similarity,
# contract clones, fraud patterns).
# LANCE_DIR=/var/data/lance

# Embedding provider: infinity (default, local + free via a local Infinity
# server exposing the OpenAI-compatible /embeddings endpoint) or openai
# (any OpenAI-compatible /embeddings endpoint).
# EMBEDDING_PROVIDER=infinity
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_BASE_URL=http://localhost:8001
# EMBEDDING_API_KEY=
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DIM=1024

# Query API: set to 0 to disable the /api/v1/search and /api/v1/similar
# endpoints (they return 503).
# VECTOR_SEARCH_ENABLED=1

# ═══════════════════════════════════════════════════════════════════════
# NATS JetStream Real-Time Streaming
# ═══════════════════════════════════════════════════════════════════════

# Fan indexed events out to NATS for real-time consumers after ClickHouse
# writes (transfers → chain.{chain}.transfer, DEX swaps →
# chain.{chain}.dex.swap, deployer events → chain.{chain}.deploy, whale
# alerts → alerts.whale.{chain}). Best-effort with a circuit breaker —
# NATS downtime never blocks indexing. Default OFF; run the server with
# `docker compose -f compose.nats.yml up -d`.
# NATS_ENABLED=1
# NATS_URL=nats://localhost:4222

# Circuit breaker: consecutive failures before publishes are dropped, and
# how long the circuit stays open (seconds).
# NATS_CIRCUIT_FAILURE_THRESHOLD=5
# NATS_CIRCUIT_COOLDOWN_SECONDS=30

# Publish through JetStream (auto-provisions a CHAIN_EVENTS stream
# capturing chain.> / alerts.>); degrades to core NATS if unavailable.
# NATS_JETSTREAM_ENABLED=1
# NATS_STREAM_NAME=CHAIN_EVENTS

# ═══════════════════════════════════════════════════════════════════════
# Webhook Delivery (push platform)
# ═══════════════════════════════════════════════════════════════════════

# POST every NATS event to registered webhooks (HMAC-SHA256 signed,
# bounded retries). Goldsky charges for this; we ship it free. Requires
# NATS_ENABLED=1 — the delivery service is a NATS subscriber. Default ON.
# WEBHOOK_ENABLED=1

# Retry attempts after the initial POST (backoff 1s, 4s, 16s).
# WEBHOOK_MAX_RETRIES=3

# Per-request HTTP timeout and total delivery budget (seconds).
# WEBHOOK_TIMEOUT_SECONDS=10
# WEBHOOK_TOTAL_TIMEOUT_SECONDS=30

# SQLite persistence for subscriptions + delivery log.
# WEBHOOK_DB_PATH=/var/data/chain-indexer/webhooks.db

# Per-IP cap on webhook registrations (API layer).
# WEBHOOK_MAX_PER_IP=10

# ═══════════════════════════════════════════════════════════════════════
# Resilience & Self-Healing (hardening 2026-08-04)
# ═══════════════════════════════════════════════════════════════════════

# Backward-state guard: when the state file's last_block regressed more
# than STATE_REGRESSION_TOLERANCE_BLOCKS below the monotonic high-water
# mark (or the ClickHouse max), resume from ClickHouse instead of
# re-indexing from genesis. Default ON.
# STATE_BACKWARD_PROTECTION=1
# STATE_REGRESSION_TOLERANCE_BLOCKS=100

# In-process memory watchdog: pause NEW chain ingestion when RSS exceeds
# MEMORY_HIGH_MB (default 6144 = 6 GiB, matching the systemd MemoryHigh
# drop-in). Backstop before the cgroup OOM reaper fires.
# MEMORY_HIGH_MB=6144
# MEMORY_CHECK_INTERVAL=15
# MEMORY_PAUSE_SLEEP=30

# Periodic GC: force gc.collect() every N sync cycles per chain.
# GC_EVERY_N_CYCLES=5

# ClickHouse health pause: probe CH before fetching RPC events; when CH
# is unreachable, abort the cycle with status "ch_unavailable" (no state
# movement, no RPC budget burned, no crash).
# CH_HEALTH_CHECK_ENABLED=1
# CH_HEALTH_INTERVAL=30

# Endpoint hard ban (403/429): exponential "do not touch" window.
# ENDPOINT_BAN_BASE_SECONDS=60
# ENDPOINT_BAN_CAP_SECONDS=3600

# Periodic data reconciliation: every N cycles compare the ClickHouse
# row count for the synced range against events fetched from RPC; a
# shortfall above the max discrepancy % rewinds state so the next cycle
# backfills the range.
# DATA_RECONCILIATION_ENABLED=1
# DATA_RECONCILIATION_EVERY_N_CYCLES=50
# DATA_RECONCILIATION_MAX_DISCREPANCY_PCT=5.0

# ═══════════════════════════════════════════════════════════════════════
# Intelligent RPC Throttling (final production push 2026-08-04)
# ═══════════════════════════════════════════════════════════════════════

# Persisted per-endpoint rate-limit tracker state (X-RateLimit-* headers,
# Retry-After windows, per-method budgets). Survives restarts so a
# mid-429-window restart does not re-hammer the endpoint.
# RPC_THROTTLE_FILE=/var/data/chain-indexer/rpc_throttle.json

# Pre-emptive throttle threshold: when an endpoint advertises a budget
# and more than this % is consumed, slow down BEFORE the 429 arrives.
# RPC_PREEMPTIVE_THRESHOLD_PCT=80.0

# Per-method request budgets (req/s) used when the endpoint does not
# advertise headers. eth_getLogs is expensive on free tiers; blockNumber
# is cheap. Override any single method via the dict below.
# RPC_METHOD_DEFAULT_RATE=10.0

# Hard cap (s) on the pre-emptive/adaptive sleep. Retry-After from a
# real 429 is honored exactly and may exceed this cap.
# RPC_THROTTLE_MAX_WAIT=30.0

# ═══════════════════════════════════════════════════════════════════════
# Chain-Level Health / Auto-Disable (daemon)
# ═══════════════════════════════════════════════════════════════════════

# If a chain's state has not advanced for CHAIN_STALL_DISABLE_SECONDS
# (default 2h), the daemon auto-disables it and re-probes slowly so one
# dead chain never burns RPC budget while the others keep indexing.
# CHAIN_AUTO_DISABLE_ENABLED=1
# CHAIN_STALL_DISABLE_SECONDS=7200
# CHAIN_DISABLED_RECHECK_SECONDS=900

# ═══════════════════════════════════════════════════════════════════════
# Solana Address Backfill (free getSignaturesForAddress parity)
# ═══════════════════════════════════════════════════════════════════════
# On-demand recovery of a wallet's transaction history into
# wallet_memory.address_activity, fetched ONCE from free RPC and served
# locally forever after (never-re-fetch guard table). Provider order:
# public -> public fallback -> Alchemy -> Helius (keys via env, never code).
# ADDRESS_BACKFILL_ENABLED=1
# ADDRESS_BACKFILL_MAX_SIGNATURES=1000
# ADDRESS_BACKFILL_MAX_TX=250
# ADDRESS_BACKFILL_LAZY_MAX_TX=50
# ADDRESS_BACKFILL_PAGE_SIZE=100
# ADDRESS_BACKFILL_CONCURRENCY=4
# ADDRESS_BACKFILL_TIMEOUT=20.0
# ADDRESS_BACKFILL_ATTEMPT_TTL=300.0
# CH_ADDRESS_BACKFILL_STATE_TABLE=wallet_memory.address_backfill_state
# Override the free provider endpoints (${ALCHEMY_KEY}/${HELIUS_KEY} honored):
# SOLANA_PUBLIC_RPC=https://api.mainnet-beta.solana.com
# SOLANA_PUBLIC_RPC_FALLBACK=https://solana-rpc.publicnode.com
# SOLANA_ALCHEMY_RPC_TEMPLATE=https://solana-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
# SOLANA_HELIUS_RPC_TEMPLATE=https://mainnet.helius-rpc.com/?api-key=${HELIUS_KEY}

# ═══════════════════════════════════════════════════════════════════════
# Solana Real-Time Websocket Ingestion (free, watchlist-scoped)
# ═══════════════════════════════════════════════════════════════════════
# Subscribes to RPC logsSubscribe (program mentions) / accountSubscribe
# (watchlist) and indexes each notified transaction into address_activity.
# No API key. Watchlist/program-scoped on purpose — not full-chain.
# SOLANA_WS_ENABLED=0
# SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# SOLANA_WS_PROGRAMS=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
# SOLANA_WS_ACCOUNTS=
# SOLANA_WS_COMMITMENT=finalized
# SOLANA_WS_PING_INTERVAL=30.0
# SOLANA_WS_RECONNECT_BASE_SECONDS=1.0
# SOLANA_WS_RECONNECT_MAX_SECONDS=60.0
# SOLANA_WS_MAX_RECONNECTS=0
