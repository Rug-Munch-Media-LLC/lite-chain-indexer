# LiteChainIndexer — Environment Variables
# Copy this to .env or set in your environment

# Data directory for state + parquet (NDJSON is optional, see NDJSON_ENABLED)
# DATA_DIR=/var/data/chain-indexer

# ClickHouse connection
# CH_HOST=127.0.0.1            (alias: CLICKHOUSE_HOST)
# CH_PORT=9000                 (alias: CLICKHOUSE_PORT)
# CH_USER=default              (alias: CLICKHOUSE_USER)
# CH_PASSWORD=
# CH_DATABASE=wallet_memory

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# RPC timeout (seconds)
# RPC_TIMEOUT=30

# Disk cap (bytes) — default 10GB
# DISK_CAP_GB=10

# ═══════════════════════════════════════════════════════════════════════
# v1.3.0 Feature Flags
# ═══════════════════════════════════════════════════════════════════════

# NDJSON write-ahead log (default OFF — redundant with ClickHouse; recovery
# is restart-from-state with at most one ~30s sync cycle lost)
# NDJSON_ENABLED=0

# Lazy per-chain DEX/deployer indexing (default ON): long-tail chains index
# DEX/deployer events only after the scanner signals demand via a file touch
# in INDEXER_DEMAND_DIR. Set to 0 for the legacy all-events behavior.
# LAZY_INDEXING_ENABLED=1
# INDEXER_DEMAND_DIR=/tmp/indexer-demand

# Enrichment stripping — always on, non-configurable. Transfer rows carry
# only hot-path columns; token metadata lives in wallet_memory.token_meta_ref.

# Address-first wallet access projections on evm_transfers
# WALLET_PROJECTION_ENABLED=1

# Per-token incremental holder balance cache
# BALANCE_CACHE_ENABLED=1

# SummingMergeTree materialized holder balances (auto-maintained by CH)
# HOLDER_BALANCES_MV_ENABLED=1

# Reorg staging + fork rollback (EVM; Solana/Tron never invoke the EVM module)
# REORG_PROTECTION_ENABLED=1

# Default ON — the collector is bounded per-cycle and rate-limit-aware. Set to 0
# to disable. Per-cycle block cap + concurrency also tunable.
# TRACE_ENABLED=1
# TRACE_MAX_BLOCKS_PER_CYCLE=100
# TRACE_CONCURRENCY=2

# Balance reconciliation (TrueBlocks-style): computed vs on-chain balances
# RECONCILIATION_ENABLED=1
# RECONCILIATION_SAMPLE_SIZE=100

# Bloom pre-filtering (geth-conformant byte order)
# BLOOM_ENABLED=1
# Optional Redis backing for the bloom cache
# REDIS_URL=

# Column-level ClickHouse TTL / retention
# CH_TTL_ENABLED=1

# Parquet cold tier
# PARQUET_COLD_DAYS=7
# PARQUET_REMOTE=b2-crypt:chain-data/parquet

# ═══════════════════════════════════════════════════════════════════════
# Paid RPC Support
# ═══════════════════════════════════════════════════════════════════════
# 
# When ALLOW_PAID_RPC=true, the indexer falls back to FREEMIUM and PAID
# tier RPC endpoints (Infura, Alchemy, Helius, etc.) when free endpoints
# are exhausted or rate-limited. Set to "true" to enable.
# 
# ALLOW_PAID_RPC=false
# 
# API keys for paid/freemium RPC endpoints. These are resolved from
# ${ENV_VAR} templates defined in lite_indexer/chains/endpoints.py and
# lite_indexer/chains/non_evm.py. Leave unset to use only free public RPCs.
# Unexpanded ${ENV_VAR} placeholders are filtered from the pool at import.
# 
# INFURA_KEY=
# ALCHEMY_KEY=
# GETBLOCK_KEY=
# CHAINSTACK_KEY=
# QUICKNODE_ENDPOINT=
# HELIUS_KEY=
# TRONGRID_KEY=

# ═══════════════════════════════════════════════════════════════════════
# Whale Detection + USD Price Normalization
# ═══════════════════════════════════════════════════════════════════════

# A DEX swap is a whale when the USD notional of either leg is >= this
# threshold (needs a price from token_prices), OR the raw amount exceeds
# the per-chain heuristic threshold. Written to dex_events.whale (UInt8).
# WHALE_THRESHOLD_USD=100000

# Per-chain raw-amount heuristic thresholds (base units) as JSON, e.g.
# WHALE_AMOUNT_THRESHOLDS_JSON='{"ethereum": 1000000000000000000000000}'
# (defaults: 1e23 EVM / 1e14 Solana / 1e11 Tron ~= $100K at $1 per token)

# USD price feed (DefiLlama primary + CoinGecko fallback, free tiers, no
# API keys). Master switch + refresh interval (seconds, default 900 = 15m).
# PRICING_ENABLED=1
# PRICING_REFRESH_INTERVAL=900

# Free-tier request pacing (seconds between calls per provider)
# COINGECKO_MIN_INTERVAL=12
# DEFILLAMA_MIN_INTERVAL=2

# Token budget per refresh + recent-window scan
# PRICING_MAX_TRACKED_TOKENS=2500
# PRICING_TOKEN_WINDOW_DAYS=7

# Backfill: lite-indexer backfill-whales --chain ethereum --days 90 --dry-run

# ═══════════════════════════════════════════════════════════════════════
# LanceDB Vector Store (AI-vector-ready indexing)
# ═══════════════════════════════════════════════════════════════════════

# Embedded vector database directory. No server process — LanceDB is
# columnar, disk-based, and zero-cost. Pairs with ClickHouse: CH answers
# analytical SQL, LanceDB answers semantic/ANN queries (wallet similarity,
# contract clones, fraud patterns).
# LANCE_DIR=/var/data/lance

# Embedding provider: ollama (default, local + free) or openai (any
# OpenAI-compatible /embeddings endpoint).
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_API_KEY=
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DIM=768

# Query API: set to 0 to disable the /api/v1/search and /api/v1/similar
# endpoints (they return 503).
# VECTOR_SEARCH_ENABLED=1

# ═══════════════════════════════════════════════════════════════════════
# NATS JetStream Real-Time Streaming
# ═══════════════════════════════════════════════════════════════════════

# Fan indexed events out to NATS for real-time consumers after ClickHouse
# writes (transfers → chain.{chain}.transfer, DEX swaps →
# chain.{chain}.dex.swap, deployer events → chain.{chain}.deploy, whale
# alerts → alerts.whale.{chain}). Best-effort with a circuit breaker —
# NATS downtime never blocks indexing. Default OFF; run the server with
# `docker compose -f compose.nats.yml up -d`.
# NATS_ENABLED=1
# NATS_URL=nats://localhost:4222

# Circuit breaker: consecutive failures before publishes are dropped, and
# how long the circuit stays open (seconds).
# NATS_CIRCUIT_FAILURE_THRESHOLD=5
# NATS_CIRCUIT_COOLDOWN_SECONDS=30

# Publish through JetStream (auto-provisions a CHAIN_EVENTS stream
# capturing chain.> / alerts.>); degrades to core NATS if unavailable.
# NATS_JETSTREAM_ENABLED=1
# NATS_STREAM_NAME=CHAIN_EVENTS
